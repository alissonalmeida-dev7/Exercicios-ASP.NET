@model Evento
@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes do Evento</h1>
<p><strong>Id do Evento: </strong>@Model.Id</p>
<p><strong>Nome do Evento: </strong>@Model.Nome</p>
<p><strong>Descrição do Evento: </strong>@Model.Descricao</p>
<p><strong>Local do Evento: </strong>@Model.Local</p>
<p><strong>Data do Evento: </strong>@Model.DataEvento.ToShortDateString()</p>
<p><strong>Quantidade de Vagas: </strong>@Model.QuantidadeVagas.ToString("N0")</p>
<p><strong>Valor do Ingresso: </strong>@Model.ValorIngresso.ToString("C")</p>

<a asp-action="Index">Voltar</a>